# انسخ هذا الملف إلى backend/.env محلياً أو عيّن القيم في منصة الاستضافة.
# لا ترفع ملف .env إلى Git ولا تشاركه في المحادثات.

# التشغيل
NODE_ENV=production
PORT=3001
# اتركه فارغاً محلياً؛ عيّنه إلى /var/data/store.db عند استخدام قرص Render الدائم.
DATABASE_PATH=

# نطاق أو نطاقات الواجهة المسموح لها بالوصول إلى API في الإنتاج، مفصولة بفواصل.
CORS_ORIGIN=https://example.com

# حماية جلسات المستخدمين والإدارة — استخدم سلسلة عشوائية طويلة وفريدة.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# اختياري: يُنشأ المدير فقط عند عدم وجود مدير في قاعدة بيانات جديدة.
# بعد الإنشاء الأول، احذف هذه القيم من بيئة التشغيل أو اتركها غير مضبوطة.
ADMIN_NAME=Site Administrator
ADMIN_PHONE=REPLACE_WITH_ADMIN_PHONE
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# بيانات WhatsApp/API لا توضع هنا حالياً؛ تُدار من لوحة الإدارة عند الحاجة.
# لا تُفعّل أي ربط مزود خدمات خارجي من دون مرحلة مستقلة واختبارات آمنة.
