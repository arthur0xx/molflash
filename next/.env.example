# Firebase Web App — values visible to the browser are prefixed NEXT_PUBLIC_
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public fixed HTTPS origin used only as Firebase password-reset return URL.
NEXT_PUBLIC_APP_URL=https://temporary-speedy-jade-mdelya8.vercel.app

# Firebase Admin — server-side only. Never expose these values in the browser or Git.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail SMTP — server-side only. Use a Google App Password, never the Google account password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_SENDER_NAME=ChriGsm

# Local development only
USE_FIREBASE_EMULATORS=false

# Transactional email — recommended for production with a verified sending domain.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=ChriGsm
EMAIL_REPLY_TO=

# WhatsApp support fallback — a public Moroccan business number, digits only (e.g. 2126XXXXXXXX).
# This only enables a direct wa.me link when the UI uses it; it does not enable API sending.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# WhatsApp Business Cloud API — server-side only. Leave disabled until Meta templates and webhooks are configured.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_ADMIN_PHONE=
WHATSAPP_PHONE_VERIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_ORDER_PROCESSING=
WHATSAPP_TEMPLATE_ORDER_COMPLETED=
WHATSAPP_TEMPLATE_ORDER_DELIVERY_ADDED=
WHATSAPP_TEMPLATE_ADMIN_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_ADMIN_ORDER_PROCESSING=
WHATSAPP_TEMPLATE_ADMIN_ORDER_COMPLETED=
WHATSAPP_TEMPLATE_ADMIN_ORDER_DELIVERY_ADDED=
WHATSAPP_TEMPLATE_ADMIN_SUPPORT_NEW=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# موصل AI الخارجي للمدونة فقط.
# عند false أو عند غياب أي حقل مطلوب، يبقى الموصل معطلاً ولا يجري أي اتصال خارجي.
CONTENT_AI_ENABLED=false
# اسم يظهر للمالك في CMC فقط، مثال: Gemini أو Spark أو Grok.
CONTENT_AI_PROVIDER=
# openai-chat لمعظم المزودين المتوافقين مع OpenAI، أو gemini-generate-content لواجهة Gemini.
CONTENT_AI_PROTOCOL=openai-chat
# رابط POST الكامل للمزود. يجب أن يكون HTTPS وأن ينتمي لمضيف موجود في القائمة المسموحة.
CONTENT_AI_API_URL=
# رمز وصول خادمي؛ لا تضعه في NEXT_PUBLIC_ أو Firestore أو Git.
CONTENT_AI_API_TOKEN=
# اسم النموذج كما يحدده المزود.
CONTENT_AI_MODEL=
# أسماء المضيفين فقط، مفصولة بفواصل ودون https:// أو مسار. مثال: api.openai.com,generativelanguage.googleapis.com
CONTENT_AI_ALLOWED_HOSTS=
# تعليمات ثابتة للكاتب، بحد أقصى 4000 حرف. لا تمنح AI أي صلاحيات تنفيذ أو نشر.
CONTENT_AI_INSTRUCTIONS=اكتب بالعربية الواضحة. لا تخترع حقائق أو أسعارًا أو مصادر. اترك أي معلومة غير مؤكدة بصيغة تحتاج مراجعة.
# حد يومي للمالك من 1 إلى 100 لحماية الاستهلاك.
CONTENT_AI_DAILY_LIMIT=12
