rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // تظل قراءة SDK المباشرة محصورة في المالك الكامل؛ صلاحيات manager تمر عبر مسارات API خادمية محددة.
    function owner() { return signedIn() && (request.auth.token.role == 'admin' || request.auth.token.role == 'owner'); }
    function ownsCustomer(customerId) { return signedIn() && request.auth.uid == customerId; }
    function activeCustomer() {
      let customer = get(/databases/$(database)/documents/customers/$(request.auth.uid)).data;
      return signedIn() && (!('accountStatus' in customer) || customer.accountStatus != 'blocked');
    }
    function activeOwner(customerId) { return ownsCustomer(customerId) && activeCustomer(); }

    match /categories/{categoryId} {
      allow read: if true;
      // تتطلب جميع كتابات CMC تحققًا خادميًا وسجل تدقيق؛ لا كتابة مباشرة من العميل.
      allow write: if false;
    }
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || owner();
      // تتطلب جميع كتابات CMC تحققًا خادميًا وسجل تدقيق؛ لا كتابة مباشرة من العميل.
      allow write: if false;
    }
    match /blogCategories/{categoryId} {
      allow read: if resource.data.isActive == true || owner();
      // التصنيفات تعدل عبر مسارات المالك الخادمية لتسجيل التدقيق ومنع النشر العرضي.
      allow write: if false;
    }
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || owner();
      // المقالات والمسودات لا تتغير من SDK مباشر، حتى لا تتجاوز التحقق من slug والمصادر والنشر.
      allow write: if false;
    }
    // مراجع المورد والكلفة والربحية لا تمر إلى العميل؛ تعدل فقط عبر Firebase Admin داخل المسارات الخادمية.
    match /servicePrivate/{serviceId} {
      allow read, write: if false;
    }
    match /customers/{customerId} {
      allow read: if owner() || activeOwner(customerId);
      // تعديلات الرصيد تتم ذريًا في مسار خادمي يضيف قيد محفظة وسجل تدقيق؛ لا كتابة مباشرة من العميل حتى للمدير.
      allow write: if false;
    }
    // رموز Expo قابلة لإرسال إشعارات لهذا الجهاز؛ تُدار من API خادمي موثق فقط ولا تُكشف لأي SDK.
    match /customers/{customerId}/pushTokens/{tokenId} {
      allow read, write: if false;
    }
    match /orders/{orderId} {
      allow read: if owner() || (activeCustomer() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /walletEntries/{entryId} {
      allow read: if owner() || (activeCustomer() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    // لا يرى تعريفات وسائل الدفع أو مسودات البوابات إلا المالك؛ العرض الآمن للعميل يمر عبر API ويعيد الحقول اللازمة فقط.
    match /paymentMethods/{methodId} {
      allow read: if owner();
      allow write: if false;
    }
    // يمكن للعميل قراءة تحويلاته فقط. الإنشاء والمراجعة وتغيير الحالة تتم جميعها عبر Firebase Admin ومسارات خادمية مدققة.
    match /payments/{paymentId} {
      allow read: if owner() || (activeCustomer() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /supportTickets/{ticketId} {
      allow read: if owner() || (activeCustomer() && resource.data.customerId == request.auth.uid);
      // الرسائل والردود تمر عبر مسارات خادمية تتحقق من الهوية وتسجل التدقيق؛ لا كتابة مباشرة.
      allow write: if false;
    }
    match /auditLogs/{logId} { allow read: if owner(); allow write: if false; }
    // عدادات موصل AI تشغيلية، وتُحدَّث ذريًا عبر Firebase Admin فقط لحماية سقف الاستعمال اليومي.
    match /blogAiUsage/{usageId} { allow read, write: if false; }
    // رموز تأكيد الهاتف وسجل قنوات الإشعار يحتويان بيانات تشغيلية حساسة؛ لا يُسمح لهما بأي وصول SDK مباشر.
    match /phoneVerificationChallenges/{challengeId} { allow read, write: if false; }
    match /notificationLogs/{notificationId} { allow read, write: if false; }
  }
}
