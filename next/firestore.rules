rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    function ownsCustomer(customerId) { return signedIn() && request.auth.uid == customerId; }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if admin();
    }
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || admin();
      allow write: if admin();
    }
    match /customers/{customerId} {
      allow read: if admin() || ownsCustomer(customerId);
      allow write: if admin();
    }
    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /walletEntries/{entryId} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /auditLogs/{logId} { allow read: if admin(); allow write: if false; }
  }
}
